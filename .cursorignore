# Flutter 子仓本地 Cursor / Agent 索引忽略

# 依赖目录
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/ephemeral/

# iOS / Android 生成缓存
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/android/.gradle/
**/android/app/build/
**/android/build/

# IDE / OS
.idea/
.vscode/
.fvm/
*.iml
.DS_Store

# 编译产物
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
**/*.gr.dart

# 日志 / 大文件
*.log
pubspec.lock
