# 宿主机：$DEPLOY_TARGET_DIR/todo-flutter/env
# compose: docker compose -p todo-flutter-test -f docker-compose.yml --env-file env up -d

CLIENT_DOCKER_NETWORK=db-bridge
NGINX_IMAGE=nginx:1.27-alpine
# nginx 使用静态 conf（client.nginx.conf）；上游在 conf 中写死 yudao-server:48080
# npm todo-test.zh04.com → 本端口
CLIENT_PORT=38090
